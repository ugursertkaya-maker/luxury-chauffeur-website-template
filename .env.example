# =============================================================================
#  ENVIRONMENT CONFIGURATION — copy to .env.local and fill in
# =============================================================================
#
#    cp .env.example .env.local
#
#  Every value below is a PLACEHOLDER. None of them work. See docs/API_SETUP.md
#  for step-by-step instructions on creating each account and generating each
#  credential.
#
#  Never commit .env.local — it is already in .gitignore.
#
#  Legend:
#    [REQUIRED]  the site will not run without it
#    [FEATURE]   one specific feature stays off until you set it
#    [OPTIONAL]  nice to have, safe to leave blank
# =============================================================================


# -----------------------------------------------------------------------------
#  SITE  [REQUIRED]
# -----------------------------------------------------------------------------
# Public origin of your site, no trailing slash. Used for canonical URLs,
# sitemap entries, Open Graph tags and links inside transactional emails.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://example.com

# Legacy duplicate of the above, still read by the corporate-portal invite
# email. Set it to the same value. (See docs/KNOWN_ISSUES.md.)
NEXT_PUBLIC_BASE_URL=https://example.com


# -----------------------------------------------------------------------------
#  SUPABASE — database  [REQUIRED]
# -----------------------------------------------------------------------------
# Project Settings -> Data API / API Keys in the Supabase dashboard.
# The service-role key bypasses row-level security: server-side only, never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
#  AUTHENTICATION SECRETS  [REQUIRED]
# -----------------------------------------------------------------------------
# Signs the admin, customer and corporate session cookies (HS256).
# Generate:  openssl rand -hex 48
JWT_SECRET=generate-a-long-random-value-see-docs

# Salt for stored password hashes. Generate a second, different random value.
# WARNING: changing this invalidates every existing password. Set it once,
# before creating your admin user, then leave it alone.
# Generate:  openssl rand -hex 32
PASSWORD_SALT=generate-a-second-long-random-value


# -----------------------------------------------------------------------------
#  STRIPE — card payments  [FEATURE: online payment]
# -----------------------------------------------------------------------------
# Start in TEST mode. Keys beginning sk_test_ / pk_test_ cannot move real money.
# The webhook secret comes from the endpoint you create at
# https://<your-domain>/api/webhooks — see docs/API_SETUP.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret


# -----------------------------------------------------------------------------
#  GOOGLE MAPS  [REQUIRED for booking]
# -----------------------------------------------------------------------------
# Two separate keys from the same Google Cloud project:
#   browser key — restrict by HTTP referrer; it is visible in page source
#   server key  — restrict by IP, never expose it
# Enable: Maps JavaScript API, Places API, Geocoding API, Distance Matrix API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key


# -----------------------------------------------------------------------------
#  RESEND — transactional email  [FEATURE: all outbound email]
# -----------------------------------------------------------------------------
# Without this, booking confirmations, invoices and driver credentials are
# never delivered. Your sending domain must be verified in Resend first.
#
# REQUIRED AT BUILD TIME: the Resend SDK throws on construction when the key is
# absent, so `npm run build` fails outright without it. Any non-empty value is
# enough to build; a real key is needed to actually send.
RESEND_API_KEY=re_your_resend_api_key

# Audience for the newsletter signup form. Leave blank to disable signups.
RESEND_AUDIENCE_ID=


# -----------------------------------------------------------------------------
#  INBOUND EMAIL WEBHOOK  [FEATURE: admin inbox]
# -----------------------------------------------------------------------------
# Shared secret your forwarding provider must present when POSTing to
# /api/webhooks/inbound-email. Generate: openssl rand -hex 24
INBOUND_EMAIL_SECRET=


# -----------------------------------------------------------------------------
#  GMAIL OAUTH  [FEATURE: Gmail inbox sync in /admin/emails]
# -----------------------------------------------------------------------------
# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). The redirect URI must match EXACTLY, including scheme.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://example.com/api/auth/gmail/callback


# -----------------------------------------------------------------------------
#  CRON  [FEATURE: reminders, monthly invoices and statements]
# -----------------------------------------------------------------------------
# Shared secret required by the /api/cron/* endpoints. Without it those
# endpoints reject every call. Generate: openssl rand -hex 24
CRON_SECRET=


# -----------------------------------------------------------------------------
#  FLIGHT TRACKING  [FEATURE: flight status in the admin booking drawer]
# -----------------------------------------------------------------------------
# AviationStack is the primary lookup. FlightAware AeroAPI is an optional
# higher-accuracy override: if set, it is tried first.
AVIATIONSTACK_API_KEY=
FLIGHTAWARE_API_KEY=


# -----------------------------------------------------------------------------
#  TWILIO — SMS  [FEATURE: SMS reminders and driver/rating alerts]
# -----------------------------------------------------------------------------
# Still wired up and functional in three places:
#   /api/cron/reminders        day-before SMS to the customer
#   /api/bookings/[id]         driver assignment + en-route/arrived updates
#   /api/rate                  new-rating alert to ADMIN_PHONE
# Leave all four blank to run the site without SMS — every call site is
# guarded and silently skips when unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE=


# -----------------------------------------------------------------------------
#  ANALYTICS  [OPTIONAL]
# -----------------------------------------------------------------------------
# GA4 Measurement ID. The gtag script is only injected when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
#  INSTAGRAM FEED  [OPTIONAL]
# -----------------------------------------------------------------------------
# Requires an Instagram Business or Creator account linked to a Facebook page.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# -----------------------------------------------------------------------------
#  GOOGLE REVIEWS  [OPTIONAL]
# -----------------------------------------------------------------------------
# Direct "write a review" link, offered after a 5-star rating. Also required
# before the homepage rating badge will render — and that badge additionally
# needs brand.aggregateRating filled in (src/config/brand.ts).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
